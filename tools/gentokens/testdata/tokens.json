{
  "$comment": "黄金测试用的小样本：每一组、每一种写法各来一个。",
  "version": 1,
  "colors": [
    { "name": "bg", "value": "#000000", "ios": "systemBackground", "use": "页面底色" },
    { "name": "text-secondary", "value": "rgba(235, 235, 245, 0.6)", "ios": "secondaryLabel", "use": "次要文字" },
    { "name": "accent", "value": "#0a84ff", "ios": "systemBlue", "use": "可点击" },
    { "name": "glass", "value": "rgba(9, 9, 11, 0.78)", "targets": ["css"], "use": "只给网页的毛玻璃" },
    { "name": "teal", "value": "#5ac8fa", "use": "只读信息，固定值" }
  ],
  "posterTones": [
    { "name": "poster-tone", "l": 0.76, "c": 0.085, "text": true, "use": "强调文字" },
    { "name": "poster-tone-low", "l": 0.24, "c": 0.045, "text": false, "use": "填充" }
  ],
  "fonts": [
    { "name": "font-cjk", "families": ["PingFang SC", "system-ui", "sans-serif"], "use": "中文回落链" },
    { "name": "font-latin", "families": ["Sora", "var(--font-cjk)"], "use": "拉丁显示字体" }
  ],
  "type": [
    { "name": "body", "size": 16, "weight": 400, "tracking": 0, "iosTextStyle": "body", "use": "正文" },
    { "name": "wordmark", "size": 20, "weight": 700, "tracking": -0.01, "family": "font-latin", "iosFont": "Sora", "use": "字标" },
    { "name": "web-only", "size": 13, "weight": 600, "tracking": 0.1, "targets": ["css", "lua"], "use": "不进 Swift，所以不用填 iOS 样式" }
  ],
  "spacing": [
    { "name": "sm", "value": 8, "use": "基础单位" },
    { "name": "xxl", "value": 48, "targets": ["css"], "use": "只给网页" }
  ],
  "radii": [
    { "name": "md", "value": 12, "use": "卡片" }
  ],
  "durations": [
    { "name": "toast-in", "value": 260, "use": "提示进场" }
  ],
  "easings": [
    { "name": "standard", "value": [0.4, 0, 0.2, 1], "use": "默认缓动" }
  ],
  "shadows": [
    { "name": "focus", "value": "0 0 0 3px rgba(10, 132, 255, 0.4)", "use": "焦点" }
  ],
  "layout": [
    { "name": "nav-h", "value": 64, "targets": ["css"], "use": "顶栏高度" },
    { "name": "touch-min", "value": 44, "use": "触控目标" },
    { "name": "bp-sm", "value": 600, "targets": [], "use": "只进文档的断点" }
  ],
  "contrast": {
    "foregrounds": ["text-secondary", "accent"],
    "backgrounds": ["bg"],
    "pairs": [{ "fg": "bg", "bg": "accent", "use": "黑字在蓝底上" }]
  }
}
